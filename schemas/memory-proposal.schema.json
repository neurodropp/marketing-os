{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marketing OS memory proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "subject",
    "content"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "kind": {
      "enum": [
        "fact",
        "research",
        "insight",
        "strategy",
        "decision",
        "asset",
        "metric",
        "learning",
        "session"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential"
      ]
    },
    "review_after": {
      "type": "string",
      "format": "date"
    }
  }
}
